{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atrium:litellm-associations:v1",
  "title": "Protected LiteLLM native credential associations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "installation", "issuer", "generation", "generated_at", "expires_at", "associations"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "atrium.litellm-associations"},
    "installation": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "integer", "minimum": 1},
    "associations": {
      "type": "array",
      "items": {"$ref": "#/$defs/association"}
    }
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "logicalId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "credential_id", "native_key_id", "principal_id", "authority_id", "domain", "template_id", "native_team_id", "issued_at", "expires_at", "device_id", "state", "effective_limits"],
      "properties": {
        "issuer": {"type": "string", "minLength": 1},
        "credential_id": {"$ref": "#/$defs/hash"},
        "native_key_id": {"$ref": "#/$defs/hash"},
        "principal_id": {"$ref": "#/$defs/identity"},
        "authority_id": {"$ref": "#/$defs/identity"},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"},
        "template_id": {"$ref": "#/$defs/logicalId"},
        "native_team_id": {"$ref": "#/$defs/logicalId"},
        "issued_at": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "integer", "minimum": 1},
        "device_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
        "state": {"enum": ["active", "revoked"]},
        "effective_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["models", "routes", "budget"],
          "properties": {
            "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/logicalId"}},
            "routes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["/chat/completions", "/v1/chat/completions", "/completions", "/v1/completions", "/embeddings", "/v1/embeddings", "/responses", "/v1/responses", "/messages", "/v1/messages", "/anthropic/v1/messages"]}
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usd", "duration_seconds"],
              "properties": {
                "usd": {"type": "number", "exclusiveMinimum": 0},
                "duration_seconds": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
