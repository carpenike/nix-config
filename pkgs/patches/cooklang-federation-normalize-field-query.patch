+    async fn nix_patch_query_visibility_and_database_rebuild() {
+        use crate::indexer::{SearchIndex, SearchQuery};
+
+        let (pool, recipe_id) = seeded_pool().await;
+        let directory = tempfile::tempdir().unwrap();
+        let index = Arc::new(SearchIndex::new(directory.path()).unwrap());
+        let crawler = Crawler::new(test_config())
+            .unwrap()
+            .with_search_index(index.clone());
+        crawler.index_changed_recipes(&pool, &[recipe_id]).await;
+        assert!(db::recipes::get_recipe(&pool, recipe_id)
+            .await
+            .unwrap()
+            .indexed_at
+            .is_some());
+
+        let query = |text: &str, page, limit| SearchQuery {
+            q: text.into(),
+            page,
+            limit,
+            locale: None,
+        };
+        for text in [
+            "title: \tChocolate",
+            "servings: [24 TO 24]",
+            "total_time: [45 TO 45]",
+        ] {
+            let result = index.search(&query(text, 1, 10), 100).unwrap();
+            assert_eq!(result.total, 1, "{text}");
+            assert_eq!(result.results[0].recipe_id, recipe_id, "{text}");
+        }
+        assert_eq!(index.search(&query(" \t", 1, 10), 100).unwrap().total, 1);
+        assert!(index
+            .search(&query("unknown_field:value", 1, 10), 100)
+            .is_err());
+        assert!(index
+            .search(&query("", 2, 100), 1)
+            .unwrap()
+            .results
+            .is_empty());
+        assert_eq!(index.search(&query("", 1, 0), 0).unwrap().total, 1);
+
+        sqlx::query("UPDATE recipes SET title = 'Vanilla cake' WHERE id = ?")
+            .bind(recipe_id)
+            .execute(&pool)
+            .await
+            .unwrap();
+        crawler.index_changed_recipes(&pool, &[recipe_id]).await;
+        assert_eq!(
+            index.search(&query("chocolate", 1, 10), 100).unwrap().total,
+            0
+        );
+        assert_eq!(
+            index.search(&query("vanilla", 1, 10), 100).unwrap().total,
+            1
+        );
+
+        let mut phantom = db::recipes::get_recipe(&pool, recipe_id).await.unwrap();
+        phantom.id = i64::MAX;
+        phantom.title = "Ghost document".into();
+        {
+            let mut writer = index.locked_writer().await.unwrap();
+            index
+                .index_recipe(&mut writer, &phantom, None, &[], &[])
+                .unwrap();
+            index.commit(&mut writer).unwrap();
+        }
+        assert_eq!(index.search(&query("ghost", 1, 10), 100).unwrap().total, 1);
+        assert_eq!(index.rebuild_from_database(&pool, 0).await.unwrap(), 1);
+        assert_eq!(index.search(&query("ghost", 1, 10), 100).unwrap().total, 0);
+        assert_eq!(
+            index.search(&query("vanilla", 1, 10), 100).unwrap().total,
+            1
+        );
+    }
