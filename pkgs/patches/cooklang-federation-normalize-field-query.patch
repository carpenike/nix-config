+    /// Rebuild search from the durable database before accepting requests.
+    pub async fn rebuild_from_database(&self, pool: &DbPool, batch_size: i64) -> Result<usize> {
+        let batch_size = batch_size.max(1);
+        {
+            let mut writer = self.locked_writer().await?;
+            writer
+                .delete_all_documents()
+                .map_err(|e| Error::Search(format!("Failed to clear search index: {e}")))?;
+            self.commit(&mut writer)?;
+        }
+
+        let mut offset = 0;
+        let mut total_indexed = 0;
+        loop {
+            let recipes = crate::db::recipes::list_all_recipes(pool, batch_size, offset).await?;
+            if recipes.is_empty() {
+                break;
+            }
+            let ids = recipes.iter().map(|recipe| recipe.id).collect::<Vec<_>>();
+            total_indexed += crate::indexer::extras::reindex_recipes(pool, self, &ids).await?;
+            offset += batch_size;
+        }
+
+        info!("Search index rebuilt from {total_indexed} database recipes");
+        Ok(total_indexed)
+    }
