{
  "uid": "www-warwed-traffic",
  "title": "W.W.W. — warwed.com traffic",
  "description": "Public-site (warwed.com) traffic from the app's own logs in Loki (30-day retention). Top row works on today's request lines; bottom row uses the structured public page view line once whiskey-whiskey-whiskey ships it. Cloudflare's Free plan has no referrer/query data, so this is the only source for UTM and referrer breakdowns.",
  "tags": [
    "whiskey-whiskey-whiskey",
    "warwed",
    "traffic"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "host",
        "label": "Host",
        "query": "warwed\\.com",
        "current": {
          "text": "warwed\\.com",
          "value": "warwed\\.com"
        },
        "description": "Regex for req.host on request lines (escaped)."
      },
      {
        "type": "textbox",
        "name": "exclude_ips",
        "label": "Exclude IPs (regex)",
        "query": "^(10\\..*|192\\.168\\..*|172\\.(1[6-9]|2[0-9]|3[01])\\..*|127\\..*|::1|f[cd][0-9a-f]{2}:.*|fe80:.*)$",
        "current": {
          "text": "^(10\\..*|192\\.168\\..*|172\\.(1[6-9]|2[0-9]|3[01])\\..*|127\\..*|::1|f[cd][0-9a-f]{2}:.*|fe80:.*)$",
          "value": "^(10\\..*|192\\.168\\..*|172\\.(1[6-9]|2[0-9]|3[01])\\..*|127\\..*|::1|f[cd][0-9a-f]{2}:.*|fe80:.*)$"
        },
        "description": "Client IPs to drop (full-match regex). On Forge this default is rewritten at runtime by whiskey-traffic-exclusions to also cover the home public IPv4 address and IPv6 /64; the committed default is LAN/loopback only."
      },
      {
        "type": "custom",
        "name": "ua_class",
        "label": "UA class",
        "query": "human,human|unknown,human|unknown|bot|unfurl",
        "current": {
          "text": "human",
          "value": "human"
        },
        "options": [
          {
            "text": "human",
            "value": "human",
            "selected": true
          },
          {
            "text": "human|unknown",
            "value": "human|unknown",
            "selected": false
          },
          {
            "text": "human|unknown|bot|unfurl",
            "value": "human|unknown|bot|unfurl",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Server request lines — works on today's logs",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "description": "Regex over the app's \"incoming request\" lines: GET of public pages on $host. Excludes Cloudflare-range client IPs, the exclude_ips regex, and obvious bot user agents (no-op until the request log carries userAgent). Counts requests, not people; unique IPs are a rough visitor proxy."
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "auto-loki-auto"
      },
      "description": "GET /, /events, /events/<slug>[/competition[/register]], /doctrine in the selected range.",
      "id": 2,
      "type": "stat",
      "title": "Public page requests",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "auto-loki-auto"
          },
          "expr": "sum(count_over_time({unit=\"whiskey-whiskey-whiskey.service\"} |= \"incoming request\" |~ `\"host\":\"$host\"` |~ `\"method\":\"GET\",\"url\":\"/(events(/[a-z0-9-]+(/competition(/register)?)?)?|doctrine)?/?(\\?[^\"]*)?\"` !~ `\"remoteAddress\":\"(2a06:98c0|2400:cb00|2606:4700|2803:f800|2405:b500|2405:8100|2c0f:f248):` !~ `\"userAgent\":\"[^\"]*(?i:bot|crawl|spider|slurp|scan|curl|wget|python|go-http|okhttp|java/|headless|preview|facebookexternalhit|whatsapp)` | regexp `\"url\":\"(?P<path>[^\"?]*)` | regexp `\"remoteAddress\":\"(?P<ip>[^\"]+)\"` | ip !~ `$exclude_ips` [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "instant": true
        }
